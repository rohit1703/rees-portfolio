{
  "name": "rees-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Reethika Chitithoti's UX portfolio: home page and three case studies.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "verify": "node scripts/verify-build.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run verify",
    "deploy:link": "vercel link --yes --team rohit1703s-projects --project rees-portfolio-deploy",
    "deploy": "npm run check && vercel deploy --prod --yes --scope rohit1703s-projects",
    "deploy:preview": "npm run check && vercel deploy --yes --scope rohit1703s-projects"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "motion": "^14.0.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/fjalla-one": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vercel": "^63.1.0",
    "vitest": "^5.0.3"
  }
}
